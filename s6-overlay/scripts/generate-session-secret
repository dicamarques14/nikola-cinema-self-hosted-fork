#!/command/with-contenv sh

# Mirrors generate-api-key-and-secret: web-ui signs session cookies, CSRF
# tokens, Stremio playback links, unsubscribe links and -- unless
# S3_SIGNING_SECRET is set separately -- every user's S3 secret key with
# SESSION_SECRET.
#
# This oneshot is REQUIRED, not belt-and-braces. web-ui used to default the
# value to the literal "secret123" published in its source; since 2026-08 that
# default is gone and web-ui refuses to start without the variable
# (requireSessionSecret in web-ui/serve.go). So this script is what lets the
# container come up at all -- do not "simplify" it away on the grounds that
# the bad default it used to guard against no longer exists.
#
# Persisting matters just as much as generating: a fresh value on every start
# would log the administrator out on each restart and invalidate every S3
# credential the instance has issued, because those are derived from this
# secret rather than stored.

log() {
   echo "$1" | s6-log p"[generate-session-secret]" 1
}

# Values are written single-quoted: this file is re-read with `source` as
# root, so a bare value containing $(...), a backtick, a space or an
# apostrophe would execute, break the file, or silently arrive different
# from what the operator set.
shquote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# The secret lives on the data volume and /etc/webtor/secrets/session.env
# (what web-ui/run sources) links to it. /etc is the container's writable
# layer: it survives a restart but not a recreate, so every image update used
# to mint a new secret -- signing everyone out and invalidating every issued
# S3 credential. $DATA_DIR/.webtor is outside torrent-web-seeder-cleaner's
# sweep (see s6-rc.d/redis/run).
data_dir=${DATA_DIR:-/data}
f="$data_dir/.webtor/secrets/session.env"
link=/etc/webtor/secrets/session.env
umask 077
mkdir -p "$(dirname "$f")" "$(dirname "$link")"

# One-time migration: an instance that already generated its secret in /etc
# (a restart of a container from before this change) keeps it, so nobody is
# signed out and no S3 key changes by upgrading in place.
if [ ! -f "$f" ] && [ -f "$link" ] && [ ! -L "$link" ]; then
  log "moving existing ${link} to ${f}"
  cp -p "$link" "$f"
fi

if [ -n "$SESSION_SECRET" ]; then
  log "using provided SESSION_SECRET"
  log "storing SESSION_SECRET to ${f}"
  printf 'SESSION_SECRET=%s\n' "$(shquote "$SESSION_SECRET")" > "$f"
elif [ -f "$f" ]; then
  log "secret file ${f} already exists"
else
  log "generating SESSION_SECRET"
  log "storing SESSION_SECRET to ${f}"
  printf 'SESSION_SECRET=%s\n' "$(shquote "$(uuidgen | sha1sum | head -c 40)")" > "$f"
fi
chmod 600 "$f"
ln -sfn "$f" "$link"
